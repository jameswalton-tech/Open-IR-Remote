{
  "name": "open-ir-sdk-local-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./irdb": {
      "types": "./dist/irdb.d.ts",
      "import": "./dist/irdb.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vendor",
    "scripts",
    "test",
    "examples",
    "requirements.txt",
    "tsconfig.json",
    "README.md",
    "API-DESIGN.md",
    "NOTICE.md",
    "FOOTPRINT.json",
    "VERIFICATION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "measure": "node scripts/measure.mjs",
    "example": "node examples/quickstart.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.9",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}
