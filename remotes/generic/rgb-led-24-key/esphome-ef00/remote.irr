      "led-strip"
    ],
    "manufacturer": "Generic",
    "model": "24-key RGB LED Remote",
    "name": "Generic 24-key RGB LED Remote",
    "variant": "ESPHome EF00 source variant"
  },
  "updated": "2026-09-13",
  "validation": {
    "evidence": [
      "https://github.com/mxbchr/esphome_rgb_led_remote/blob/a683da09ff1c1e18188ccd233e58abf352fdcb73/esphome_rgb_led_remote.yaml",
      "Source photo shows a 24-button handset; all 24 source definitions have a name, NEC address and command. Source values are retained verbatim.",
      "https://esphome.io/components/remote_transmitter/#remote-transmitter-transmit-nec-action"
    ],
    "issues": [
      "Not tested on physical hardware by this contributor. Exact manufacturer, printed model number and measured carrier frequency are not supplied by the source.",
      "Remote GREEN occurs at commands 0xFA05 and 0xEA15. Both source labels are retained; the latter uses a code-qualified ID rather than a guessed corrected label.",
      "The esphome-nec-16bit profile retains both full 16-bit fields, including command inverse bits. A transmitter must implement this profile; do not treat command_hex as an 8-bit command.",
      "Physical key-to-code mapping and compatibility with visually similar remotes remain unverified."
    ],
    "status": "imported-unverified"
  }
}
