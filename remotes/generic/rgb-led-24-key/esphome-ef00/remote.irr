  "provenance": [
    {
      "imported_at": "2026-09-13",
      "notes": "All 24 NEC receiver definitions are preserved, including the repeated Remote GREEN label. The source README identifies the pictured generic RGB LED handset. Names describe source configuration entries, not necessarily printed button wording.",
      "rights": "GPL-3.0, mxbchr/esphome_rgb_led_remote contributors. See source/LICENSE. This imported record is not CC0.",
      "source_path": "https://github.com/mxbchr/esphome_rgb_led_remote/blob/a683da09ff1c1e18188ccd233e58abf352fdcb73/esphome_rgb_led_remote.yaml",
      "source_revision": "a683da09ff1c1e18188ccd233e58abf352fdcb73",
      "source_type": "upstream-reference"
    }
  ],
