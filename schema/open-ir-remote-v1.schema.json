{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jameswalton-tech.github.io/Open-IR-Remote/schema/open-ir-remote-v1.schema.json",
  "title": "Open IR Remote record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_kind",
    "id",
    "updated",
    "remote",
    "locale",
    "commands",
    "provenance",
    "validation"
  ],
  "properties": {
    "export_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "version"],
      "properties": {
        "application": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "build": {"type": "string", "minLength": 1, "maxLength": 120},
        "url": {"type": "string", "format": "uri"},
        "exported_at": {"type": "string", "format": "date-time"}
      }
    },
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "open-ir-remote"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "record_kind": {
      "enum": [
        "canonical",
        "export",
        "legacy-import",
        "example"
      ]
    },
    "id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^oir:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[a-z0-9]+(?:[.-][a-z0-9]+)*)+$"
        },
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
        }
      ]
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "remote": {
      "$ref": "#/$defs/remote"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "manufacturer",
        "model",
        "variant",
        "device_types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "remote_model_number": {
          "type": "string",
          "maxLength": 100
        },
        "device_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "controlled_devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "manufacturer",
              "model",
              "device_type"
            ],
            "properties": {
              "manufacturer": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "device_type": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "width_px",
        "height_px",
        "size_bytes",
        "sha256",
        "background",
        "rights",
        "alt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/].*\\.webp$"
        },
        "media_type": {
          "const": "image/webp"
        },
        "width_px": {
          "type": "integer",
          "minimum": 240,
          "maximum": 1600
        },
        "height_px": {
          "type": "integer",
          "minimum": 240,
          "maximum": 1600
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "background": {
          "enum": [
            "transparent",
            "plain-white",
            "plain-neutral"
          ]
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "holder",
            "notice"
          ],
          "properties": {
            "basis": {
              "enum": [
                "licensed",
                "permission",
                "public-domain",
                "identification-only"
              ]
            },
            "holder": {
              "type": "string",
              "minLength": 1
            },
            "licence": {
              "type": "string"
            },
            "source_url": {
              "type": "string",
              "format": "uri"
            },
            "notice": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "carrier_hz": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "duty_cycle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labels",
        "signals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "action": {
          "enum": [
            "toggle",
            "on",
            "off",
            "increment",
            "decrement",
            "select",
            "stop",
            "macro",
            "unknown"
          ]
        },
        "behaviour": {
          "$ref": "#/$defs/behaviour"
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signal"
          }
        }
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "discrete",
            "toggle",
            "stateful",
            "unknown"
          ]
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "same",
                "sequence",
                "toggle",
                "protocol",
                "unknown"
              ]
            },
            "minimum_count": {
              "type": "integer",
              "minimum": 1
            },
            "interval_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "primary",
        "source_complete"
      ],
      "properties": {
        "kind": {
          "enum": [
            "decoded",
            "raw",
            "pronto"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "source_complete": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "carrier_hz": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "duty_cycle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "intro_us": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "repeat_us": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "ending_us": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "pronto_hex": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f ]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decoded"
              }
            }
          },
          "then": {
            "required": [
              "protocol",
              "parameters"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "raw"
              }
            }
          },
          "then": {
            "required": [
              "carrier_hz",
              "intro_us"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pronto"
              }
            }
          },
          "then": {
            "required": [
              "pronto_hex"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_path",
        "imported_at",
        "rights"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "contributor-capture",
            "device-export",
            "manufacturer-document",
            "csv-import",
            "upstream-reference"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string"
        },
        "imported_at": {
          "type": "string",
          "format": "date"
        },
        "rights": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "imported-unverified",
            "decoded",
            "device-tested",
            "community-verified",
            "rejected"
          ]
        },
        "tested_at": {
          "type": "string",
          "format": "date"
        },
        "tester": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
