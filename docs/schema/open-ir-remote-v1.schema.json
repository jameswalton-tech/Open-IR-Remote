{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jameswalton-tech.github.io/Open-IR-Remote/schema/open-ir-remote-v1.schema.json",
  "title": "Open IR Remote record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_kind",
    "id",
    "updated",
    "remote",
    "locale",
    "commands",
    "provenance",
    "validation"
  ],
  "properties": {
    "export_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "version"
      ],
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "exported_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "maxProperties": 5,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "$schema": {
      "type": "string",
      "maxLength": 2048
    },
    "format": {
      "const": "open-ir-remote"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "record_kind": {
      "enum": [
        "canonical",
        "export",
        "legacy-import",
        "example"
      ]
    },
    "id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^oir:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[a-z0-9]+(?:[.-][a-z0-9]+)*)+$",
          "maxLength": 1024
        },
        {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$",
          "maxLength": 1024
        }
      ],
      "maxLength": 160
    },
    "updated": {
      "type": "string",
      "format": "date",
      "maxLength": 10
    },
    "remote": {
      "$ref": "#/$defs/remote"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      },
      "maxItems": 128
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance"
      },
      "maxItems": 16
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/extensionValue"
      }
    }
  },
  "$defs": {
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "manufacturer",
        "model",
        "variant",
        "device_types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "remote_model_number": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "device_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "maxItems": 16
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 16
        },
        "controlled_devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "manufacturer",
              "model",
              "device_type"
            ],
            "properties": {
              "manufacturer": {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              "model": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "device_type": {
                "type": "string",
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "additionalProperties": false,
            "maxProperties": 3,
            "propertyNames": {
              "maxLength": 64
            }
          },
          "maxItems": 32
        }
      },
      "maxProperties": 8,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "width_px",
        "height_px",
        "size_bytes",
        "sha256",
        "background",
        "rights",
        "alt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/].*\\.webp$",
          "maxLength": 2048
        },
        "media_type": {
          "const": "image/webp"
        },
        "width_px": {
          "type": "integer",
          "minimum": 240,
          "maximum": 1600
        },
        "height_px": {
          "type": "integer",
          "minimum": 240,
          "maximum": 1600
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 1024
        },
        "background": {
          "enum": [
            "transparent",
            "plain-white",
            "plain-neutral"
          ]
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "holder",
            "notice"
          ],
          "properties": {
            "basis": {
              "enum": [
                "licensed",
                "permission",
                "public-domain",
                "identification-only"
              ]
            },
            "holder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "licence": {
              "type": "string",
              "maxLength": 120
            },
            "source_url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "notice": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "maxProperties": 5,
          "propertyNames": {
            "maxLength": 64
          }
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "maxProperties": 9,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "carrier_hz": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "duty_cycle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "maxProperties": 3,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labels",
        "signals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 64
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "maxItems": 16
        },
        "action": {
          "enum": [
            "toggle",
            "on",
            "off",
            "increment",
            "decrement",
            "select",
            "stop",
            "macro",
            "unknown"
          ]
        },
        "behaviour": {
          "$ref": "#/$defs/behaviour"
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signal"
          },
          "maxItems": 3,
          "contains": {
            "type": "object",
            "required": [
              "primary"
            ],
            "properties": {
              "primary": {
                "const": true
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "maxProperties": 6,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "discrete",
            "toggle",
            "stateful",
            "unknown"
          ]
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "same",
                "sequence",
                "toggle",
                "protocol",
                "unknown"
              ]
            },
            "minimum_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "notes": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "maxProperties": 4,
          "propertyNames": {
            "maxLength": 64
          }
        }
      },
      "maxProperties": 2,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "primary",
        "source_complete"
      ],
      "properties": {
        "kind": {
          "enum": [
            "decoded",
            "raw",
            "pronto"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "source_complete": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "carrier_hz": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "duty_cycle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 4294967295
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            ]
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 64
          },
          "patternProperties": {
            "_hex$": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1024,
              "pattern": "^0x[0-9A-Fa-f]+$"
            }
          }
        },
        "intro_us": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer",
            "minimum": -2147483647,
            "maximum": 2147483647,
            "not": {
              "const": 0
            }
          },
          "maxItems": 4096
        },
        "repeat_us": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483647,
            "maximum": 2147483647,
            "not": {
              "const": 0
            }
          },
          "maxItems": 4096
        },
        "ending_us": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483647,
            "maximum": 2147483647,
            "not": {
              "const": 0
            }
          },
          "maxItems": 4096
        },
        "pronto_hex": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{4}( [0-9A-Fa-f]{4}){3,8191}$",
          "maxLength": 40959,
          "minLength": 19
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decoded"
              }
            }
          },
          "then": {
            "required": [
              "parameters"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "intro_us"
                  ]
                },
                {
                  "required": [
                    "repeat_us"
                  ]
                },
                {
                  "required": [
                    "ending_us"
                  ]
                },
                {
                  "required": [
                    "pronto_hex"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "raw"
              }
            }
          },
          "then": {
            "required": [
              "intro_us"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parameters"
                  ]
                },
                {
                  "required": [
                    "pronto_hex"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pronto"
              }
            }
          },
          "then": {
            "required": [
              "pronto_hex"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parameters"
                  ]
                },
                {
                  "required": [
                    "intro_us"
                  ]
                },
                {
                  "required": [
                    "repeat_us"
                  ]
                },
                {
                  "required": [
                    "ending_us"
                  ]
                }
              ]
            }
          }
        }
      ],
      "maxProperties": 11,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_path",
        "imported_at",
        "rights"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "contributor-capture",
            "device-export",
            "manufacturer-document",
            "csv-import",
            "upstream-reference"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source_revision": {
          "type": "string",
          "maxLength": 120
        },
        "imported_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        },
        "rights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "maxProperties": 6,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "imported-unverified",
            "decoded",
            "device-tested",
            "community-verified",
            "rejected"
          ]
        },
        "tested_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        },
        "tester": {
          "type": "string",
          "maxLength": 120
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 32
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        }
      },
      "maxProperties": 5,
      "propertyNames": {
        "maxLength": 64
      }
    },
    "extensionValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/extensionValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/extensionValue"
          }
        }
      ]
    }
  },
  "maxProperties": 15,
  "propertyNames": {
    "maxLength": 64
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "defaults"
          ],
          "properties": {
            "defaults": {
              "required": [
                "protocol"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "commands": {
            "items": {
              "properties": {
                "signals": {
                  "items": {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "decoded"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "protocol"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "defaults"
          ],
          "properties": {
            "defaults": {
              "required": [
                "carrier_hz"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "commands": {
            "items": {
              "properties": {
                "signals": {
                  "items": {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "raw"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "carrier_hz"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
